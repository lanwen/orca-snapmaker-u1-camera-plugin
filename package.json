{
  "name": "orca-u1-camera-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:ui": "vite build",
    "check": "pnpm check:commit && pnpm check:types",
    "test": "vitest run",
    "format": "oxfmt src/ui tests index.html src/camera.html package.json tsconfig.json vite.config.ts svelte.config.js .oxfmtrc.json .oxlintrc.json",
    "format:check": "pnpm format --check",
    "lint": "oxlint --deny-warnings src/ui tests vite.config.ts svelte.config.js",
    "check:types": "svelte-check --tsconfig ./tsconfig.json",
    "check:commit": "pnpm format:check && pnpm lint"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "eslint-plugin-security": "^4.2.1",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "{{src/ui,tests}/**/*.{svelte,ts,js,cjs,css,html,json},index.html,src/camera.html,package.json,tsconfig.json,vite.config.ts,svelte.config.js,.oxfmtrc.json,.oxlintrc.json}": "oxfmt --no-error-on-unmatched-pattern",
    "{{src/ui,tests}/**/*.{svelte,ts,js,cjs},vite.config.ts,svelte.config.js}": "oxlint --deny-warnings --no-error-on-unmatched-pattern"
  },
  "packageManager": "pnpm@12.16.1"
}
