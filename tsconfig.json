{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["svelte", "node", "vite/client"]
  },
  "include": ["src/ui/**/*.ts", "src/ui/**/*.svelte", "vite.config.ts", "tests/**/*.ts"]
}
